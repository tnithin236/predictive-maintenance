# Copy to .env and edit. Never commit .env.
# --- Paths (optional; defaults are relative to the project root) ---
# MODEL_PATH=models/model_bundle.joblib
# REPORTS_DIR=models/reports

# --- Training ---
RANDOM_SEED=42
TEST_SIZE=0.2
CV_FOLDS=3
TUNING_ITERATIONS=12
ANOMALY_CONTAMINATION=0.03

# --- Decision / risk thresholds (configurable business rules) ---
DECISION_THRESHOLD=0.50
RISK_MEDIUM_THRESHOLD=0.40
RISK_HIGH_THRESHOLD=0.70

# --- MLflow ---
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
MLFLOW_EXPERIMENT_NAME=predictive-maintenance

# --- API ---
API_URL=http://localhost:8000
MAX_BATCH_SIZE=5000

# --- Database (optional for local runs; used by docker compose) ---
POSTGRES_USER=pm_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=predictive_maintenance
DATABASE_URL=postgresql+psycopg2://pm_user:change_me@localhost:5432/predictive_maintenance
